<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data oor:name="Linguistic" oor:package="org.openoffice.Office"
    xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <node oor:name="ServiceManager">
    <node oor:name="GrammarCheckers">
      <node oor:name="org.wordwarden.libreoffice.Proofreader" oor:op="fuse">
        <prop oor:name="Locales" oor:type="oor:string-list">
          <value>en-US en-GB en-AU en-CA en-NZ en-IE en-ZA en-IN en-PH en-NA en-ZW en-BZ en-BS en-GH en-JM en-TT en-IL</value>
        </prop>
      </node>
    </node>
    <!-- Defaults for new LibreOffice profiles. Existing ones are switched once by the setup job in Wordwarden.py. -->
    <node oor:name="GrammarCheckerList">
      <prop oor:name="en-US" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-GB" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-AU" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-CA" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-NZ" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-IE" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-ZA" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-IN" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-PH" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-NA" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-ZW" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-BZ" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-BS" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-GH" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-JM" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-TT" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
      <prop oor:name="en-IL" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.Proofreader</value></prop>
    </node>
    <node oor:name="SpellCheckerList">
      <prop oor:name="en-US" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-GB" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-AU" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-CA" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-NZ" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-IE" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-ZA" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-IN" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-PH" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-NA" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-ZW" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-BZ" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-BS" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-GH" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-JM" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-TT" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
      <prop oor:name="en-IL" oor:op="fuse" oor:type="oor:string-list"><value>org.wordwarden.libreoffice.SpellChecker</value></prop>
    </node>
  </node>
</oor:component-data>
