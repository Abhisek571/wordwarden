<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data oor:name="OptionsDialog" oor:package="org.openoffice.Office"
    xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <node oor:name="Nodes">
    <node oor:name="LanguageSettings" oor:op="fuse">
      <node oor:name="Leaves">
        <node oor:name="org.wordwarden.libreoffice.options" oor:op="fuse">
          <!-- Matching the add-on's identifier puts an Options button in the Extension Manager. -->
          <prop oor:name="Id"><value>org.wordwarden.libreoffice</value></prop>
          <prop oor:name="Label"><value xml:lang="en-US">Wordwarden</value></prop>
          <prop oor:name="OptionsPage"><value>%origin%/dialog/Wordwarden.xdl</value></prop>
          <prop oor:name="EventHandlerService"><value>org.wordwarden.libreoffice.OptionsHandler</value></prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
