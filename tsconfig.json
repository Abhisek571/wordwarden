{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "#/*": ["./src/*"]
    }
  }
}
